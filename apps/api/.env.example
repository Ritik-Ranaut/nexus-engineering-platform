NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/nexus
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=900
WEB_ORIGIN=http://localhost:5173
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=choose-a-local-chat-model
EMBEDDING_MODEL=choose-a-local-embedding-model
AI_PROVIDER=ollama
AI_REQUEST_TIMEOUT_MS=60000
AI_CHAT_RETRIES=1
AI_EMBEDDING_RETRIES=2
AI_VECTOR_DIMENSIONS=768
AI_VECTOR_INDEX_NAME=nexus_code_chunks
AI_RETRIEVAL_TOP_K=5
AGENT_ANALYSIS_TIMEOUT_MS=240000
GITHUB_IMPORT_STRATEGY=git_then_api
# Optional. Used only by the API for private GitHub repositories. Never put this in frontend env files.
# GITHUB_TOKEN=
